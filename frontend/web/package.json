{
  "name": "gromit-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5175",
    "build": "tsc --noEmit && vite build",
    "build:azure": "tsc --noEmit && vite build && cd ../dashboard && npm install && npm run build && cp -r dist ../web/dist/dashboard",
    "test": "vitest run",
    "preview": "vite preview --port 5175"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "pretendard": "^1.3.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  }
}
