# backend/.env 로 복사해서 사용 (.env는 커밋 금지)

ENVIRONMENT=local
LOG_LEVEL=INFO

# 프론트 두 앱의 origin (쉼표 구분)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# 참관자가 세션 생성 시 발급할 응답자용 링크 base
INTERVIEWEE_BASE_URL=http://localhost:5173

# 대시보드 API 보호용 토큰. 비워두면 인증 없이 열림(로컬/데모 기본값).
ADMIN_TOKEN=
CLIENT_ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret-in-production
CLIENT_ACCESS_TOKEN_TTL_SECONDS=28800

# D4: 세션 상태 + 지시 큐. 비워두면 인메모리 폴백(단일 인스턴스 전용).
# 예) rediss://:<key>@<name>.redis.cache.windows.net:6380/0
REDIS_URL=

# Azure OpenAI — 비워두면 스텁 생성기가 동작해서 파이프라인만 검증 가능
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o
AZURE_OPENAI_TIMEKEEPER_DEPLOYMENT=gpt-4o-mini

# Azure Speech (TTS + TTS Avatar). STT는 미사용 (D9)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# STT 모델 (D8): gpt-transcribe | gpt-live-transcribe
STT_MODEL=gpt-transcribe
